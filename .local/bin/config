#!/bin/sh
# A menu script for quickly editing common config files

MenuChoices="alias\nbash\nlf\nmpd\nmpv\nncmpcpp\nnewsboat\nprofile\nrss\nssh\ntmux\nvim\nxprofile\nzathura\nzsh"

chosen=$1

[ -z $chosen ] && chosen=$(echo "$MenuChoices" | sort -n | fzf --prompt="Config ")

case $chosen in
	alias)		$EDITOR ~/.config/shell/aliasrc ;;
	bash)		$EDITOR ~/.bashrc ;;
	lf)		$EDITOR ~/.config/lf/lfrc ;;
	mpd)		$EDITOR ~/.config/mpd/mpd.conf ;;
	mpv)		$EDITOR ~/.config/mpv/input.conf ;;
	ncmpcpp)	$EDITOR ~/.config/ncmpcpp/config ;;
	newsboat)	$EDITOR ~/.config/newsboat/config ;;
	profile)	$EDITOR ~/.config/shell/profile ;;
	rss)		$EDITOR ~/.config/newsboat/urls ;;
	ssh)		$EDITOR ~/.ssh/config ;;
	tmux)		$EDITOR ~/.config/tmux/tmux.conf ;;
	vim)		$EDITOR ~/.config/nvim/init.vim ;;
	xprofile)	$EDITOR ~/.config/x11/xprofile ;;
	zathura)	$EDITOR ~/.config/zathura/zathurarc ;;
	zsh)		$EDITOR ~/.config/zsh/.zshrc ;;
#	appearance)	lxappearance &disown ;;
#	audio)		pavucontrol &disown ;;
#	backup)		openfile ~/.local/bin/backup ;;
#	bar)		openfile ~/.local/bin/dwmbar ;;
#	bookmarks)	openfile ~/.config/bookmarks ;;
#	contacts)	openfile ~/.config/contacts ;;
#	firefox)	firefox --preferences &disown ;;
#	input)		lxinput &>/dev/null &disown ;;
#	mutt)		openfile ~/.config/mutt/muttrc ;;
#	screens)	screen ;;
#	scripts)	$runprefix $FILE ~/.local/bin ;;
esac
